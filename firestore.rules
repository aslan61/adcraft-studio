rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unlisted paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'plan', 'credits', 'subscriptionStatus', 'createdAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.plan in ['free', 'pro', 'enterprise']
        && data.credits is number && data.credits >= 0
        && data.subscriptionStatus in ['active', 'inactive', 'trial']
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && (!('subscriptionPeriodEnd' in data) || (data.subscriptionPeriodEnd is string && data.subscriptionPeriodEnd.size() <= 64))
        && (!('dailyAdsWatched' in data) || (data.dailyAdsWatched is number && data.dailyAdsWatched >= 0))
        && (!('lastAdWatchDate' in data) || (data.lastAdWatchDate is string && data.lastAdWatchDate.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // Validation for UserSubscription
    function isValidSubscription(data) {
      return data.keys().hasAll(['id', 'userId', 'planId', 'planName', 'amount', 'status', 'creditsGranted', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.planId is string && data.planId.size() <= 64
        && data.planName is string && data.planName.size() <= 100
        && data.amount is number && data.amount >= 0
        && data.status in ['completed', 'pending', 'refunded']
        && data.creditsGranted is number && data.creditsGranted >= 0
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10))
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50))
        && (!('invoiceNumber' in data) || (data.invoiceNumber is string && data.invoiceNumber.size() <= 64));
    }

    // Validation for UserCampaign
    function isValidCampaign(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'headline', 'ctaText', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == request.auth.uid
        && data.name is string && data.name.size() <= 120
        && data.headline is string && data.headline.size() <= 200
        && data.ctaText is string && data.ctaText.size() <= 60
        && (!('workspace' in data) || (data.workspace is string && data.workspace.size() <= 100))
        && (!('subHook' in data) || (data.subHook is string && data.subHook.size() <= 250))
        && (!('aspectRatio' in data) || (data.aspectRatio is string && data.aspectRatio.size() <= 30))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // User Profile Document Root
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt;

      // Subcollection: Subscriptions / Transactions
      match /subscriptions/{subscriptionId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidSubscription(incoming());
      }

      // Subcollection: Saved Campaigns
      match /campaigns/{campaignId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidCampaign(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidCampaign(incoming())
          && incoming().userId == existing().userId
          && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(userId);
      }
    }
  }
}
